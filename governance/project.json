{
  "schema_version": "1.1",
  "project": "SAF",
  "roots": {
    "governance": "governance",
    "source": "src",
    "tests": "tests",
    "tools": "tools",
    "configs": "configs",
    "artifacts": "artifacts",
    "runs": "artifacts/runs",
    "deliverables": "deliverables",
    "paper": "deliverables/paper",
    "references": "docs/references"
  },
  "external_data": {
    "default_root": "E:/Work/Data",
    "temporary_root": "E:/Work/Data/Temporary/SAF",
    "override_env": ["SAF_DATA_ROOT", "SAF_TEMPORARY_ROOT", "SAF_FUSION360_ROOT", "SAF_THINGI_ROOT"],
    "policy": "datasets and processed runs never live in the repository"
  },
  "artifact_lifecycle": {
    "evidence_root": "artifacts/runs",
    "cache_root": "artifacts/cache",
    "cache_ttl_days": 7,
    "prune": "python tools/prune_artifacts.py --apply",
    "latest_compatibility_file": "latest.json"
  },
  "entrypoints": {
    "test": "python -m pytest tests -q",
    "gate": "python tests/gate.py",
    "conventions": "python tools/check_conventions.py",
    "paper_gate": "python deliverables/paper/pipeline/paper_gate.py --strict",
    "paper_build": "python deliverables/paper/pipeline/build_paper.py --strict-zotero"
  },
  "checks": {
    "governance": "tests/acceptance/test_governance.py",
    "deferred": "tests/acceptance/test_deferred.py",
    "conventions": "tools/check_conventions.py",
    "structure": "tools/check_structure.py",
    "artifacts": "tools/prune_artifacts.py",
    "ci": [
      ".github/workflows/conventions.yml",
      ".github/workflows/gate.yml"
    ]
  },
  "adapters": {
    "pytest": {
      "kind": "test_runner",
      "entrypoint": "python -m pytest tests -q"
    },
    "gate": {
      "kind": "decision_gate",
      "entrypoint": "python tests/gate.py",
      "output": "stdout"
    },
    "evaluation": {
      "kind": "experiment_tools",
      "root": "tools"
    },
    "figures": {
      "kind": "deliverable_generator",
      "root": "deliverables/paper/pipeline/figures",
      "output": "deliverables/paper/figures"
    },
    "latex": {
      "kind": "deliverable_builder",
      "root": "deliverables/paper/pipeline",
      "output": "deliverables/paper/outputs"
    },
    "paper": {
      "kind": "paper_gate",
      "root": "deliverables/paper/pipeline",
      "output": "deliverables/paper"
    }
  },
  "capabilities": [
    "geometry_oracle",
    "dataset_building",
    "evaluation",
    "figure_generation",
    "paper_building"
  ]
}
