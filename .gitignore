# 外部数据与机器产物：只入库说明文件，内容不入库
/data/*
!/data/README.md
/artifacts/

# 本机路径覆盖（字段同 configs/paths.yaml，可写绝对路径）
/configs/paths.local.yaml

# 论文构建临时目录与论文 PDF（成品图入库，PDF 由入库的源稿重建）
/paper/build/
/paper/outputs/*.pdf
# LaTeX 编译中间文件（正常只会出现在 paper/build/）
*.aux
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
# Python 与测试缓存
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 本地环境与编辑器/工具状态
.venv/
.env
.claude/
